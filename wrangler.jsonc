{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scribbles-gameframe",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-07-25",
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "DISCORD_ALLOWED_USER_IDS",
      "GAMEFRAME_RPG_ORIGIN_URL",
      "GAMEFRAME_RPG_PROXY_HMAC_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHES",
        "class_name": "TicTacToeMatchDurableObject"
      }
    ]
  },
  "exports": {
    "TicTacToeMatchDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  }
}
