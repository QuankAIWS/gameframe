# Copy to /etc/game-master/scribbles-gameframe-rpg.env and chmod 0600.
# The service remains loopback-only while development header authentication is active.
GAMEFRAME_ALLOW_DEVELOPMENT_AUTH=1
GAMEFRAME_RPG_HOST=127.0.0.1
GAMEFRAME_RPG_PORT=8790
GAMEFRAME_RPG_DATABASE_PATH=/var/lib/game-master/gameframe/gameframe.sqlite

# Must match RPG_GM_SERVICE_TOKEN in /etc/game-master/rpg-gm-runtime.env.
RPG_GM_BASE_URL=http://127.0.0.1:8791
RPG_GM_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

GAMEFRAME_RPG_DELIVERY_POLL_MS=250
GAMEFRAME_RPG_DELIVERY_TIMEOUT_MS=10000
